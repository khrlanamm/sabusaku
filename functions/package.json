{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run test/domain --passWithNoTests",
    "test:rules": "vitest run test/rules",
    "test:integration": "vitest run test/integration",
    "test:all": "firebase emulators:exec --project demo-sabusaku --only firestore,storage \"npm run test:rules\" && npm run build && firebase emulators:exec --project demo-sabusaku --only auth,firestore,functions \"npm run test:integration\"",
    "emulators": "npm run build && firebase emulators:start --project sabusaku",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
